# 复制为仓库根目录的 .env 后填写；这里同时供 Spring 本地启动和 Docker Compose 使用。
# replace-with 开头的值必须替换；可选功能未启用时，相应空值可保留。
# 默认按 Windows 本机运行前后端、Docker 运行 MySQL/Redis 配置。

# MySQL：本机 API 连接映射端口；生产 Compose 自动使用 mysql:3306。
DB_URL=jdbc:mysql://127.0.0.1:13306/qgents?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=qgents
DB_PASSWORD=replace-with-database-password
# MySQL 应用用户须为非 root；root 密码仅用于管理数据库。
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password
# MYSQL_HOST_PORT 与 DB_URL 中的端口需一致；此端口只用于本地 Compose。
MYSQL_HOST_PORT=13306

# Redis：REDIS_PORT 为本机 API 连接端口，REDIS_HOST_PORT 为本地 Compose 映射端口。
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_HOST_PORT=16379
REDIS_PASSWORD=replace-with-redis-password
REDIS_DATABASE=0

# 模型：DeepSeek 官方兼容接口；MAX_TOKENS 限制单次模型回复的输出长度。
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_MAX_TOKENS=4096

# 邮件：当前后端使用 SSL，通常为 465 端口；AUTH_CODE 填邮箱服务提供的授权码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=replace-with-smtp-username
SMTP_AUTH_CODE=replace-with-smtp-auth-code

# 登录；公钥由前端构建配置提供，必须与私钥和 keyId 对应。
JWT_SECRET=replace-with-at-least-32-random-bytes
RSA_KEY_ID=rsa-2026-08
# PATH 是本地 Spring 读取的资源地址，file: 表示磁盘文件。
RSA_PRIVATE_KEY_PATH=file:./src/main/resources/rsa/private_key.pem
# FILE 是生产 Compose 挂载的宿主机文件路径；容器内路径由 Compose 覆盖。
RSA_PRIVATE_KEY_FILE=./src/main/resources/rsa/private_key.pem
# 前端构建用公钥；可用字面量 \n 表示换行，修改后需重建前端。
FRONTEND_RSA_PUBLIC_KEY=

# 页面链接、GitHub App 授权跳转与浏览器跨域来源。
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 附件默认本地磁盘；启用 OSS 后浏览器直传，endpoint 使用浏览器可访问的 HTTPS 地址。
# Bucket CORS 允许前端 Origin、PUT 及 Content-Type；头像还需配置公共访问地址。
ATTACHMENT_LOCAL_ROOT=./data/attachments
ALIYUN_OSS_ENABLED=false
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_PRESIGN_EXPIRY_SECONDS=900

# GitHub App 可选；生产私钥放入 QGENTS_DATA_ROOT/github-app/private-key.pem。
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
# WEBHOOK_SECRET 用于事件验签。
GITHUB_WEBHOOK_SECRET=

# 本地 Docker Desktop 使用 npipe:////./pipe/docker_engine；Linux 使用 unix:///var/run/docker.sock。
SANDBOX_RUNTIME=docker
SANDBOX_DOCKER_HOST=npipe:////./pipe/docker_engine
# 实例标识本地默认为 local，生产默认为 production-1；共享 Docker 的多实例须分别设置 SANDBOX_INSTANCE_ID。
# 需与 sandbox-images/dev-tools 构建的标签一致，不是后端 API 镜像。
SANDBOX_DEV_TOOLS_IMAGE=qgents/sandbox-dev-tools:0.2.0
# 项目数据根：memory.md、共享 Git 数据和各 Workspace 工作树。
# 本地直跑时 docker-host-root 必须与 root 指向同一份数据的宿主机路径，Windows 用正斜杠。
PROJECT_DATA_ROOT=D:/qgents-data/projects
PROJECT_DATA_DOCKER_HOST_ROOT=D:/qgents-data/projects
# 元数据（操作锁等）由后端维护，不挂载给用户命令容器。
SANDBOX_WORKSPACE_METADATA_ROOT=D:/qgents-data/workspace-metadata
# 长命令线程池大小和模型单步工具并行数是两个独立限制。
SANDBOX_EXECUTION_THREADS=4
APP_AGENT_MAX_PARALLEL_TOOL_CALLS=4
APP_AGENT_MAX_SUBAGENTS=0
APP_AGENT_MODEL_IDLE_TIMEOUT=45s
APP_AGENT_FOCUSED_EDIT_ENABLED=true

# Linux 生产 Compose：数据目录必须为绝对路径，预先授予 UID/GID 10001 写入权限。
QGENTS_DATA_ROOT=/srv/qgents
# Linux 执行 stat -c '%g' /var/run/docker.sock 获取实际组 ID。
DOCKER_GID=999
# 前端 Docker 构建上下文；默认使用相邻的独立仓库。
FRONTEND_DIRECTORY=../qgents-fronted
# 生产 API 映射到宿主机 127.0.0.1，WEB_HOST_PORT 是浏览器访问端口。
API_HOST_PORT=8080
WEB_HOST_PORT=80
# 仅启用 tunnel profile 时填写；代理与隧道均不是启动必需项。
CLOUDFLARE_TUNNEL_TOKEN=
